# Copy to .env (gitignored) and fill in. Values here stay blank; never commit real secrets.
# Loaded by the root scripts (pnpm dev / test / eval / db:migrate / db:push) via scripts/with-env.mjs.
# Variables already set in your shell take precedence over .env.
# Only DATABASE_URL is required to boot. The two API keys are blank lines you should fill in for
# narration and Jev. Other optional values are commented out: uncomment a line
# only when you set a value (for some variables, like NARRATION_DAILY_CAP or LOG_LEVEL, a blank value counts as set, not unset).

# --- Required for local development ---
# Postgres connection string. For the docker-compose.yml database use (dev-only credentials):
#   postgresql://animosity:animosity-local-dev@localhost:5432/animosity
# For Neon use the POOLED string: host contains "-pooler", query has sslmode=require
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# (the app enforces certificate verification for sslmode=require). Docker needs no sslmode.
DATABASE_URL=
# Optional. Direct (non-pooled) Neon connection, same string without "-pooler" in the host.
# pnpm db:migrate / db:push use it when set, otherwise DATABASE_URL. The app itself never reads it.
# DATABASE_URL_UNPOOLED=
# Host port for the docker-compose Postgres (read by docker compose, not by the app).
# Defaults to 5432; set it (and the port in DATABASE_URL) if something else already uses 5432.
# POSTGRES_PORT=

# --- Neon CLI context (not read by the app) ---
# NEON_BRANCH, NEON_BRANCH_ID and NEON_FUNCTION_HOST_SUFFIX may appear in your .env: they are
# written by the Neon CLI and are not read by the app. Keep them out of this file.

# --- Optional (current code) ---
# API server port. pnpm dev defaults to 8080 when unset. Also the default eval target.
# PORT=
# Frontend (Vite) dev server port. pnpm dev maps it to PORT for the frontend process only.
# Defaults to 5173 when unset. The root dev script sets BASE_PATH=/ for the frontend itself.
# WEB_PORT=
# Set by pnpm dev from PORT (do not set by hand locally). Read by artifacts/fight-club/vite.config.ts:
# when set, Vite proxies /api to this API port. Unset when /api is routed by something else.
# API_PORT=
# development | production | test. pnpm dev sets development for the API itself.
# NODE_ENV=
# Pino log level (trace, debug, info, warn, error). Default: info.
# LOG_LEVEL=
# Maximum fresh model narrations per day. Default: 200.
# NARRATION_DAILY_CAP=

# --- Eval (pnpm eval makes paid model calls; ask first) ---
# Origin of the server to evaluate. Precedence: --base-url flag, EVAL_BASE_URL,
# then http://localhost:$PORT (default port 8080).
# EVAL_BASE_URL=

# --- Model providers ---
# Without ANTHROPIC_API_KEY, fights return a verdict with narration_status "unavailable"
# (LLM_NOT_CONFIGURED) and the server logs one startup warning. Same for OPENROUTER_API_KEY and Jev.
# Anthropic key for narration (required for narration).
ANTHROPIC_API_KEY=
# Anthropic API base URL. Default: https://api.anthropic.com
# Origin only (no path, query, fragment or credentials); https, or http on loopback
# (localhost, 127.0.0.1, [::1]). Anything else makes narration LLM_CONFIGURATION.
# ANTHROPIC_BASE_URL=
# Narration model ID. Default: claude-haiku-5-5. Blank counts as unset.
# NARRATION_MODEL=
# OpenRouter key for the Jev shadow scorer (optional). Without it, Jev reports unavailable;
# narration is unaffected.
OPENROUTER_API_KEY=
# OpenRouter System One root. Default: https://openrouter.ai/api (the SDK appends /v1/systemone).
# Same https-or-loopback-http rule, no credentials, query or fragment; invalid makes Jev unavailable.
# OPENROUTER_BASE_URL=

# --- Planned names, NOT read by any code yet ---
# Phase 5: token for the remote eval cache-bypass header.
# EVAL_TOKEN=
# Phase 5: public origin of the deployed site.
# PUBLIC_BASE_URL=
