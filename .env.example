# Copy to .env (gitignored) and fill in. Values here stay blank; never commit real secrets.
# Loaded by the root scripts (pnpm dev / test / eval / db:push) via scripts/with-env.mjs.
# Variables already set in your shell take precedence over .env.
# Optional variables are commented out: a blank value is NOT the same as unset.

# --- Required for local development ---
# Postgres connection string. For the docker-compose.yml database, see README/CLAUDE.md:
# postgresql://animosity:animosity-local-dev@localhost:5432/animosity
DATABASE_URL=
# API server port. pnpm dev defaults to 8080 when unset. Also the default eval target.
PORT=
# Frontend (Vite) dev server port. pnpm dev maps it to PORT for the frontend process only.
# Defaults to 5173 when unset. The root dev script sets BASE_PATH=/ for the frontend itself.
WEB_PORT=

# --- Optional (current code) ---
# development | production | test. pnpm dev sets development for the API itself.
# NODE_ENV=
# Pino log level (trace, debug, info, warn, error). Default: info.
# LOG_LEVEL=
# Maximum fresh model narrations per day. Default: 200.
# NARRATION_DAILY_CAP=

# --- Eval (pnpm eval makes paid model calls; ask first) ---
# Origin of the server to evaluate. Precedence: --base-url flag, EVAL_BASE_URL,
# REPLIT_DEV_DOMAIN fallback, then http://localhost:$PORT (default port 8080).
# EVAL_BASE_URL=

# --- Replit AI Integrations (to be replaced in Phase 2; leave unset) ---
# Without these, fights return a verdict with narration_status "unavailable" (LLM_NOT_CONFIGURED).
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL=
# AI_INTEGRATIONS_ANTHROPIC_API_KEY=
# AI_INTEGRATIONS_OPENROUTER_BASE_URL=
# AI_INTEGRATIONS_OPENROUTER_API_KEY=

# --- Planned names, NOT read by any code yet ---
# Phase 2: Anthropic key for narration.
# ANTHROPIC_API_KEY=
# Phase 2: optional Anthropic API base URL override.
# ANTHROPIC_BASE_URL=
# Phase 2: narration model ID (default: the model used on Replit, claude-haiku-5-5).
# NARRATION_MODEL=
# Phase 2: OpenRouter key for Jev.
# OPENROUTER_API_KEY=
# Phase 5: token for the remote eval cache-bypass header.
# EVAL_TOKEN=
# Phase 5: public origin of the deployed site.
# PUBLIC_BASE_URL=
